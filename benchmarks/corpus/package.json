{
  "name": "@example/dashboard",
  "version": "2.4.1",
  "private": true,
  "description": "Operations dashboard with \"live\" metrics and alerting",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": "^9.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "test": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "^4.5.2",
    "date-fns": "~3.6.0"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.4.5",
    "vite": "5.2.11",
    "vitest": "1.6.0"
  },
  "config": {
    "thresholds": [0.5, 0.75, 0.9, 0.99],
    "retry": { "attempts": 3, "backoffMs": 250, "jitter": true },
    "features": {
      "alerts": true,
      "darkMode": null,
      "regions": ["us-east-1", "eu-west-1", "ap-south-1"]
    }
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
